#!/data/data/com.termux/files/usr/bin/bash
# agy-login — one-command Google sign-in for agy on Termux.
#
# If you're already signed in, it just says so. If not, it starts the sign-in,
# opens the Google auth page in your browser automatically (and copies the link
# to the clipboard as backup), waits for you to finish, and verifies the
# result. The Google sign-in itself is the only step left for you.
#
#   ./agy-login
#
# Not "#!/usr/bin/env bash": Android has no /usr/bin/env.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd -P)"
AGY="$HERE/agy"
TOKEN="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"

have() { command -v "$1" >/dev/null 2>&1; }
say()  { printf '\033[1m==>\033[0m %s\n' "$*"; }
die()  { echo "agy-login: $*" >&2; exit 1; }

[ -x "$AGY" ] || die "agy wrapper not found at $AGY (run ./install.sh first)"

agy_pid=""; out=""
cleanup() {
  [ -n "$agy_pid" ] && kill "$agy_pid" 2>/dev/null
  [ -n "$out" ] && rm -f "$out"
  return 0
}
trap cleanup INT TERM

ATTEMPTS=3
attempt=1
while [ "$attempt" -le "$ATTEMPTS" ]; do
  say "checking sign-in (attempt $attempt/$ATTEMPTS)..."
  out="$(mktemp)"
  # Wide columns so the login URL doesn't wrap mid-string in the capture.
  COLUMNS=200 "$AGY" models >"$out" 2>&1 &
  agy_pid=$!

  # Watch the output: either the models list (already signed in) or the
  # "Authentication required ... visit the URL" prompt appears.
  url=""; reason=""
  for _ in $(seq 1 80); do
    if grep -q "Authentication required" "$out" 2>/dev/null; then
      url="$(grep -A1 "log in:" "$out" | tr -d '\n' | grep -o -E 'https://[^[:space:]"]+' | head -1)"
      [ -z "$url" ] && url="$(grep -o -E 'https://[^[:space:]"]+' "$out" | head -1)"
      reason="auth"; break
    fi
    if ! kill -0 "$agy_pid" 2>/dev/null; then reason="exited"; break; fi
    sleep 1
  done

  if [ "$reason" = "exited" ]; then
    wait "$agy_pid"; rc=$?
    if [ "$rc" -eq 0 ] && ! grep -q "Authentication required" "$out"; then
      say "already signed in — models are reachable"
      cleanup; trap - INT TERM; exit 0
    fi
    echo "--- agy said: ---"
    tail -20 "$out"
    cleanup; trap - INT TERM
    die "sign-in check failed (see above) — try ./agy-doctor"
  fi

  if [ "$reason" != "auth" ]; then
    # Watch loop timed out without either outcome; stop the runaway.
    kill "$agy_pid" 2>/dev/null; cleanup; trap - INT TERM
    die "agy didn't respond — try ./agy-doctor"
  fi

  [ -n "$url" ] || { kill "$agy_pid" 2>/dev/null; cleanup; trap - INT TERM; die "agy asked for sign-in but no URL was found in its output"; }

  say "opening the Google sign-in page..."
  if have termux-clipboard-set; then
    printf '%s' "$url" | termux-clipboard-set 2>/dev/null \
      && echo "(sign-in link also copied to clipboard)"
  fi
  if have termux-open-url; then
    termux-open-url "$url" 2>/dev/null \
      || echo "couldn't open the browser automatically — open this URL: $url"
  else
    echo "open this URL in your browser: $url"
    echo "(install the Termux:API app + pkg install termux-api to auto-open it next time)"
  fi
  echo "Complete the Google sign-in, then return here (agy waits ~60s)."

  wait "$agy_pid"; rc=$?
  agy_pid=""
  if [ "$rc" -eq 0 ] && [ -s "$TOKEN" ] && ! grep -q "Authentication required" "$out"; then
    say "signed in successfully."
    grep -o -E 'gemini-[a-z0-9.-]+' "$out" | sort -u | head -5
    cleanup; trap - INT TERM; exit 0
  fi
  echo "that attempt timed out or failed — trying again..."
  rm -f "$out"; out=""
  attempt=$((attempt + 1))
done

trap - INT TERM
die "couldn't complete sign-in after $ATTEMPTS attempts — run ./agy-doctor and check the network/proxy"
