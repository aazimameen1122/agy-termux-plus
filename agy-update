#!/data/data/com.termux/files/usr/bin/bash
# agy-update — update the musl build of Antigravity CLI that agy runs.
#
# agy's own updater is off (the agy wrapper sets AGY_CLI_DISABLE_AUTO_UPDATE=true)
# because it drops a stock glibc build over this install and undoes every patch,
# mid-session and without asking. This fetches Google's release deliberately,
# hands it to install.sh to patch and verify, and keeps the old binary for
# rollback.
#
#   agy-update              update to the latest published version
#   agy-update --check      report versions, change nothing
#   agy-update --changelog  show the latest release notes, change nothing
#   agy-update --force      reinstall even if already current
#   agy-update --version X  install a specific version
#   agy-update --rollback   restore the previous binary
#   agy-update --no-backup  do not keep the previous binary (saves ~210MB)
#   agy-update --official-musl / --glibc
#                           force the asset track (default: match the installed
#                           binary — static installs stay on the musl track)
#
# Not "#!/usr/bin/env bash": Android has no /usr/bin/env.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
BIN="$HERE/agy.bin"
PREV="$HERE/agy.bin.prev"
LIBDIR="$HERE/lib"
REPO="google-antigravity/antigravity-cli"
GLIBC_ASSET="agy_cli_linux_arm64.tar.gz"
MUSL_ASSET="agy_cli_linux_arm64_musl.tar.gz"
NEED_MB=600          # tarball + extracted copy + the patched build, with headroom

CHECK=0; FORCE=0; WANT=""; BACKUP=1; ROLLBACK=0; CHANGELOG=0; TRACK=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check)     CHECK=1 ;;
    --changelog) CHANGELOG=1 ;;
    --force)     FORCE=1 ;;
    --no-backup) BACKUP=0 ;;
    --rollback)  ROLLBACK=1 ;;
    --official-musl) TRACK=musl ;;
    --glibc)         TRACK=glibc ;;
    --version)   shift; WANT="${1:?--version needs a value}" ;;
    -h|--help)   sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)           echo "agy-update: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

die() { echo "agy-update: $*" >&2; exit 1; }

# --- network helpers ------------------------------------------------------------
# GitHub API and downloads go through a fallback chain (curl, then python3's
# urllib), so one broken tool on the phone does not block updates.
github_api() { # api-path -> stdout
  local url="https://api.github.com/repos/$REPO/$1"
  if command -v curl >/dev/null 2>&1; then
    timeout 120 curl -sSL -H 'Accept: application/vnd.github+json' "$url" 2>/dev/null && return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    [ -z "${SSL_CERT_FILE:-}" ] && [ -r "${PREFIX:-/data/data/com.termux/files/usr}/etc/tls/cert.pem" ] \
      && export SSL_CERT_FILE="${PREFIX:-/data/data/com.termux/files/usr}/etc/tls/cert.pem"
    python3 - "$url" <<'EOF' 2>/dev/null && return 0
import os, ssl, sys, urllib.request
ca = os.environ.get("SSL_CERT_FILE")
ctx = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()
req = urllib.request.Request(sys.argv[1],
        headers={"Accept": "application/vnd.github+json", "User-Agent": "agy-termux-plus"})
sys.stdout.buffer.write(urllib.request.urlopen(req, timeout=120, context=ctx).read())
EOF
  fi
  return 1
}

download() { # url dest
  local url="$1" dest="$2"
  if [ -t 2 ]; then PROG=--progress-bar; else PROG=--no-progress-meter; fi
  if command -v curl >/dev/null 2>&1; then
    timeout 900 curl -fL $PROG --retry 3 --retry-delay 2 -o "$dest" "$url" 2>/dev/null \
      && [ -s "$dest" ] && return 0
    echo "agy-update: curl failed, trying python3" >&2
  fi
  if command -v python3 >/dev/null 2>&1; then
    echo "agy-update: downloading with python3 (no progress bar)" >&2
    python3 - "$url" "$dest" <<'EOF' 2>/dev/null && [ -s "$dest" ] && return 0
import os, ssl, sys, urllib.request
url, dest = sys.argv[1], sys.argv[2]
ca = os.environ.get("SSL_CERT_FILE")
ctx = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()
req = urllib.request.Request(url, headers={"User-Agent": "agy-termux-plus"})
with urllib.request.urlopen(req, timeout=900, context=ctx) as r, open(dest, "wb") as f:
    while True:
        b = r.read(1 << 20)
        if not b: break
        f.write(b)
EOF
  fi
  return 1
}

# Print release notes for a tag (tries "1.2.8" and "v1.2.8" forms).
changelog() { # tag
  local tag="$1" meta body
  meta="$(github_api "releases/tags/$tag" 2>/dev/null)" || meta="$(github_api "releases/tags/v$tag" 2>/dev/null)" || return 1
  body="$(printf '%s' "$meta" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("body") or "(no release notes)")' 2>/dev/null)" || return 1
  printf '%s\n' "$body" | head -30
}

command -v python3 >/dev/null || die "python3 is required (pkg install python)"
[ -x "$HERE/install.sh" ] || die "install.sh is missing from $HERE"

if [ "$ROLLBACK" = 1 ]; then
  [ -f "$PREV" ] || die "no previous binary at $PREV"
  mv -f "$PREV" "$BIN.rollback.$$" && mv -f "$BIN" "$PREV" \
    && mv -f "$BIN.rollback.$$" "$BIN" || die "rollback failed"
  echo "rolled back to $(env -u LD_PRELOAD LD_LIBRARY_PATH="$LIBDIR" "$BIN" --version 2>/dev/null || echo unknown)"
  echo "(the version you rolled away from is kept at $PREV)"
  exit 0
fi

# PT_INTERP of a binary; empty for static binaries.
interp_of() {
  python3 - "$1" <<'EOF' 2>/dev/null
import struct, sys
p = sys.argv[1]
with open(p, "rb") as f:
    d = f.read(64)
    if d[:4] != b"\x7fELF": sys.exit(1)
    phoff, = struct.unpack("<Q", d[32:40])
    phentsize, phnum = struct.unpack("<HH", d[54:58])
    f.seek(phoff)
    ph = f.read(phentsize * phnum)
    for i in range(phnum):
        e = ph[i*phentsize:(i+1)*phentsize]
        ptype, = struct.unpack("<I", e[:4])
        if ptype == 3:  # PT_INTERP
            off, = struct.unpack("<Q", e[16:24]); sz, = struct.unpack("<Q", e[32:40])
            f.seek(off); sys.stdout.write(f.read(sz).split(b"\0")[0].decode()); break
EOF
}

# Stay on the installed track unless forced: a static agy.bin came from
# Google's official musl asset, a dynamic one from the glibc asset + patches.
if [ -z "$TRACK" ]; then
  if [ -f "$BIN" ] && [ -z "$(interp_of "$BIN")" ]; then TRACK=musl; else TRACK=glibc; fi
fi
ASSET="$GLIBC_ASSET"; [ "$TRACK" = musl ] && ASSET="$MUSL_ASSET"

# Read the installed version off the binary rather than through the wrapper:
# the wrapper would repair a stock build first, which is the thing being replaced.
current="$(env -u LD_PRELOAD LD_LIBRARY_PATH="$LIBDIR" "$BIN" --version 2>/dev/null | head -1 | tr -d '[:space:]')"
[ -n "$current" ] || current="(none installed)"

if [ -n "$WANT" ]; then
  version="$WANT"
else
  meta="$(github_api "releases/latest")" \
    || die "could not reach the GitHub API"
  [ -n "$meta" ] || die "empty response from the GitHub API"
  # 2>&1 so the reason travels in $version when this fails; a rate-limit reply
  # is valid JSON with no tag_name, and would otherwise be a blank error.
  version="$(printf '%s' "$meta" | python3 -c '
import json, sys
try:
    j = json.load(sys.stdin)
except Exception:
    sys.exit("could not parse the GitHub response")
tag = j.get("tag_name")
if not tag:
    sys.exit(j.get("message", "no tag_name in the response"))
print(tag.lstrip("v"))
' 2>&1)" || die "$version"
fi
[ -n "$version" ] || die "could not determine which version to install"

if [ "$CHANGELOG" = 1 ]; then
  echo "release notes for $version:"
  echo
  changelog "$version" || die "could not fetch release notes"
  exit 0
fi

echo "installed: $current"
echo "available: $version"
echo "track:     $TRACK"

if [ "$CHECK" = 1 ]; then
  [ "$current" = "$version" ] && echo "up to date." || echo "run without --check to update."
  exit 0
fi
if [ "$current" = "$version" ] && [ "$FORCE" != 1 ]; then
  echo "already current; use --force to reinstall."
  exit 0
fi

echo
echo "what is new in $version:"
changelog "$version" 2>/dev/null || echo "(could not fetch release notes)"
echo

avail_mb="$(df -Pm "$HERE" 2>/dev/null | awk 'NR==2{print $4}')"
if [ -n "$avail_mb" ] && [ "$avail_mb" -lt "$NEED_MB" ]; then
  die "need about ${NEED_MB}MB free, have ${avail_mb}MB"
fi

work="$(mktemp -d "$HERE/.update.XXXXXX")" || die "could not create a work directory"
trap 'rm -rf "$work"' EXIT INT TERM

url="https://github.com/$REPO/releases/download/$version/$ASSET"
echo "downloading $version — about 53MB"
download "$url" "$work/$ASSET" \
  || { if [ "$TRACK" = musl ]; then
         die "could not download $url (tried curl, python3) — the official musl asset only exists for recent releases"
       else
         die "could not download $url (tried curl, python3)"
       fi; }
tar xzf "$work/$ASSET" -C "$work" || die "could not unpack $ASSET"
[ -f "$work/antigravity" ] || die "no 'antigravity' binary inside the tarball"

# Keep the current build under a second name. install.sh replaces agy.bin with
# a rename, so a hard link goes on pointing at the old inode -- no 200MB copy,
# and nothing to undo if the update fails.
if [ "$BACKUP" = 1 ] && [ -f "$BIN" ]; then
  ln -f "$BIN" "$PREV" 2>/dev/null || cp -f "$BIN" "$PREV" \
    || die "could not set the previous version aside"
fi

# install.sh patches, proves the result runs, and only then replaces agy.bin.
"$HERE/install.sh" --from-binary "$work/antigravity" \
  || die "install.sh could not patch $version; agy.bin is unchanged"

if [ "$BACKUP" = 1 ] && [ -f "$PREV" ]; then
  echo "previous kept at $PREV ($0 --rollback, or delete to save $(du -m "$PREV" | awk '{print $1}')MB)"
fi
