#!/data/data/com.termux/files/usr/bin/bash
# agy-run — run agy like it is on a phone, because it is.
#
# Wraps ./agy with the things a long phone session wants:
#   - holds a Termux wake-lock so Android does not sleep mid-turn
#   - saves the full transcript to ~/.local/share/agy-plus/sessions/
#   - pings you when it finishes (--notify, via Termux:API)
#   - copies the output to the clipboard (--copy)
#   - reads a short summary aloud (--speak)
#   - pushes the result to your Telegram (--tg)
#
#   agy-run -p "fix the login bug" --notify --copy
#   agy-run --tg --name refactor -- models
#   agy-run -- <any agy args>
#
# --tg needs ~/.config/agy-plus/telegram.env with:
#   AGY_TG_BOT_TOKEN=...   (from @BotFather)
#   AGY_TG_CHAT_ID=...     (your chat id)
#
# Not "#!/usr/bin/env bash": Android has no /usr/bin/env.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd -P)"
AGY="$HERE/agy"

NOTIFY=0; COPY=0; TG=0; SPEAK=0; NOLOG=0; NAME=""
while [ $# -gt 0 ]; do
  case "$1" in
    --notify) NOTIFY=1 ;;
    --copy)   COPY=1 ;;
    --tg)     TG=1 ;;
    --speak)  SPEAK=1 ;;
    --no-log) NOLOG=1 ;;
    --name)   shift; NAME="${1:?--name needs a value}" ;;
    --)       shift; break ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
  shift
done
[ $# -gt 0 ] || { echo "agy-run: nothing to run — agy-run -- <agy args>" >&2; exit 2; }

have() { command -v "$1" >/dev/null 2>&1; }

# --- wake lock -----------------------------------------------------------------
if have termux-wake-lock; then termux-wake-lock 2>/dev/null && WAKE=1 || WAKE=0; else WAKE=0; fi
release_wake() { [ "${WAKE:-0}" = 1 ] && have termux-wake-unlock && termux-wake-unlock 2>/dev/null; return 0; }
trap release_wake EXIT  # Ctrl-C mid-session still releases the lock

# --- session log -----------------------------------------------------------------
LOG=""
if [ "$NOLOG" = 0 ]; then
  SESSDIR="$HOME/.local/share/agy-plus/sessions"
  mkdir -p "$SESSDIR"
  stamp="$(date +%Y%m%d-%H%M%S)"
  [ -n "$NAME" ] && stamp="$stamp-$NAME"
  LOG="$SESSDIR/$stamp.log"
  { echo "=== agy-run $stamp ==="; echo "cmd: agy $*"; echo; } > "$LOG"
fi

start="$(date +%s)"
rc=0
if [ -n "$LOG" ]; then
  set -o pipefail
  "$AGY" "$@" 2>&1 | tee -a "$LOG"; rc=${PIPESTATUS[0]}
else
  "$AGY" "$@"; rc=$?
fi
dur=$(( $(date +%s) - start ))
release_wake

# --- summary ----------------------------------------------------------------------
summary="$(tail -c 3000 "$LOG" 2>/dev/null | grep -v '^$' | tail -5 || true)"
[ -n "$summary" ] || summary="(no output)"
if [ $rc -eq 0 ]; then status="done in ${dur}s"; else status="failed (exit $rc) after ${dur}s"; fi
title="agy ${NAME:-session}: $status"

[ -n "$LOG" ] && { echo; echo "---"; echo "transcript: $LOG"; }

# --- notify ------------------------------------------------------------------------
if [ "$NOTIFY" = 1 ]; then
  if have termux-notification; then
    termux-notification --title "$title" --content "$(printf '%s' "$summary" | head -c 400)" 2>/dev/null \
      || echo "agy-run: termux-notification failed" >&2
  else
    echo "agy-run: --notify needs the Termux:API app (pkg install termux-api)" >&2
  fi
fi

# --- clipboard ----------------------------------------------------------------------
if [ "$COPY" = 1 ]; then
  if have termux-clipboard-set && [ -n "$LOG" ]; then
    termux-clipboard-set < "$LOG" 2>/dev/null && echo "(transcript copied to clipboard)" \
      || echo "agy-run: termux-clipboard-set failed" >&2
  else
    echo "agy-run: --copy needs the Termux:API app and logging enabled" >&2
  fi
fi

# --- speak ----------------------------------------------------------------------------
if [ "$SPEAK" = 1 ]; then
  if have termux-tts-speak; then
    termux-tts-speak "agy session $status" 2>/dev/null || true
  else
    echo "agy-run: --speak needs the Termux:API app" >&2
  fi
fi

# --- telegram --------------------------------------------------------------------------
if [ "$TG" = 1 ]; then
  TGENV="$HOME/.config/agy-plus/telegram.env"
  if [ -r "$TGENV" ]; then
    # shellcheck disable=SC1090
    . "$TGENV"
  fi
  if [ -z "${AGY_TG_BOT_TOKEN:-}" ] || [ -z "${AGY_TG_CHAT_ID:-}" ]; then
    echo "agy-run: --tg needs AGY_TG_BOT_TOKEN and AGY_TG_CHAT_ID in $TGENV" >&2
  elif have python3; then
    msg="*agy ${NAME:-session}*: ${status}"$'\n\n'"\`\`\`"$'\n'"$(printf '%s' "$summary" | head -c 3500)"$'\n'"\`\`\`"
    AGY_TG_BOT_TOKEN="$AGY_TG_BOT_TOKEN" AGY_TG_CHAT_ID="$AGY_TG_CHAT_ID" AGY_TG_MSG="$msg" \
    python3 - <<'EOF' 2>/dev/null
import json, os, urllib.request
tok = os.environ["AGY_TG_BOT_TOKEN"]; chat = os.environ["AGY_TG_CHAT_ID"]
body = json.dumps({"chat_id": chat, "text": os.environ["AGY_TG_MSG"],
                   "parse_mode": "Markdown", "disable_web_page_preview": True}).encode()
req = urllib.request.Request(f"https://api.telegram.org/bot{tok}/sendMessage",
                             data=body, headers={"Content-Type": "application/json"})
urllib.request.urlopen(req, timeout=30).read()
print("(summary sent to Telegram)")
EOF
    [ $? -ne 0 ] && echo "agy-run: Telegram send failed (check token/chat id and network)" >&2
  else
    echo "agy-run: --tg needs python3" >&2
  fi
fi

exit "$rc"
